// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  admin
  member
}

enum InvitationRole {
  admin
  member
}

enum EventStatus {
  upcoming
  expired
  cancelled
}

enum AttendanceStatus {
  pending
  confirmed
  declined
}

enum AttendanceMarkedBy {
  self
  admin
}

enum SwapRequestStatus {
  pending
  accepted
  declined
}

model Team {
  id              Int              @id @default(autoincrement())
  name            String
  users           User[]
  invitationCodes InvitationCode[]
  events          Event[]
}

model User {
  id                   Int               @id @default(autoincrement())
  name                 String
  email                String            @unique
  passwordHash         String
  role                 UserRole
  teamId               Int?
  team                 Team?             @relation(fields: [teamId], references: [id])
  createdAt            DateTime          @default(now())
  usedInvitationCodes  InvitationCode[]
  createdEvents        Event[]
  eventAttendances     EventAttendance[]
  sentSwapRequests     SwapRequest[]     @relation("SwapRequestFromUser")
  receivedSwapRequests SwapRequest[]     @relation("SwapRequestToUser")
}

model InvitationCode {
  id           Int            @id @default(autoincrement())
  code         String         @unique
  role         InvitationRole
  teamId       Int
  team         Team           @relation(fields: [teamId], references: [id])
  used         Boolean        @default(false)
  usedByUserId Int?
  usedByUser   User?          @relation(fields: [usedByUserId], references: [id])
  createdAt    DateTime       @default(now())
}

model Event {
  id              Int               @id @default(autoincrement())
  title           String
  date            DateTime
  time            String
  location        String
  description     String?
  equipmentNeeded String?
  teamId          Int
  team            Team              @relation(fields: [teamId], references: [id])
  createdByUserId Int
  createdByUser   User              @relation(fields: [createdByUserId], references: [id])
  status          EventStatus       @default(upcoming)
  deletedAt       DateTime?
  attendances     EventAttendance[]
  swapRequests    SwapRequest[]
}

model EventAttendance {
  id       Int                @id @default(autoincrement())
  eventId  Int
  event    Event              @relation(fields: [eventId], references: [id])
  userId   Int
  user     User               @relation(fields: [userId], references: [id])
  status   AttendanceStatus   @default(pending)
  markedBy AttendanceMarkedBy @default(self)
}

model SwapRequest {
  id          Int               @id @default(autoincrement())
  eventId     Int
  event       Event             @relation(fields: [eventId], references: [id])
  fromUserId  Int
  fromUser    User              @relation("SwapRequestFromUser", fields: [fromUserId], references: [id])
  toUserId    Int
  toUser      User              @relation("SwapRequestToUser", fields: [toUserId], references: [id])
  status      SwapRequestStatus @default(pending)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?
}
